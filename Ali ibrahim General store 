  <script>
    const cart = [];
    const cartItems = document.getElementById('cartItems');
    const cartTotal = document.getElementById('cartTotal');
    const cartCountBadge = document.getElementById('cartCountBadge');

    function renderCart() {
      if (cart.length === 0) {
        cartItems.innerHTML = '<p class="text-slate-500">ابھی تک کوئی سامان شامل نہیں ہوا۔</p>';
        cartTotal.textContent = 'Rs. 0';
        cartCountBadge.textContent = '0';
        return;
      }

      let total = 0;
      let html = '';

      cart.forEach((item) => {
        total += item.price;
        html += `
          <div class="flex items-center justify-between bg-slate-50 rounded-2xl p-3 border border-slate-100">
            <div>
              <h4 class="font-bold text-slate-800">${item.name}</h4>
              <p class="text-sm text-slate-500">Rs. ${item.price}</p>
            </div>
            <button class="remove-item text-red-500 font-bold" data-name="${item.name}">حذف</button>
          </div>
        `;
      });

      cartItems.innerHTML = html;
      cartTotal.textContent = 'Rs. ' + total;
      cartCountBadge.textContent = cart.length;
    }

    document.querySelectorAll('.add-to-cart').forEach((button) => {
      button.addEventListener('click', () => {
        const name = button.dataset.name;
        const price = Number(button.dataset.price);

        cart.push({ name, price });
        renderCart();
      });
    });

    document.addEventListener('click', (event) => {
      if (event.target.classList.contains('remove-item')) {
        const name = event.target.dataset.name;
        const index = cart.findIndex((item) => item.name === name);
        if (index > -1) cart.splice(index, 1);
        renderCart();
      }
    });

    document.getElementById('checkoutBtn').addEventListener('click', () => {
      if (cart.length === 0) {
        alert('براہ کرم پہلے کوئی سامان شامل کریں۔');
        return;
      }

      let message = 'السلام علیکم! میں علی ابراہیم جنرل سٹور سے درج ذیل چیزیں آرڈر کرنا چاہتا/چاہتی ہوں:%0A%0A';
      let total = 0;

      cart.forEach((item, index) => {
        message += `${index + 1}. ${item.name} - Rs. ${item.price}%0A`;
        total += item.price;
      });

      message += `%0Aکل رقم: Rs. ${total}%0A%0Aبراہ کرم مجھے مکمل ڈیلیوری کی معلومات دے دیں۔`;

      const phone = '923367787900';
      window.open(`https://wa.me/${phone}?text=${message}`, '_blank');
    });

    const menuBtn = document.getElementById('menuBtn');
    const mobileMenu = document.getElementById('mobileMenu');

    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  </script>

